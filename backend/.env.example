# Servidor
PORT=5000
NODE_ENV=development
DEMO_MODE=true

# Base de datos
MONGO_URI=mongodb://127.0.0.1:27017/electrofix_demo

# URLs de la app
APP_URL_DEV=http://localhost:3000
APP_URL_PROD=https://your-demo-domain.com
FRONTEND_ORIGINS=http://localhost:3000,https://your-demo-domain.com

# Autenticación
JWT_SECRET=replace-with-a-long-random-secret
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_TIME=900000

# Proveedores de correo (dejar vacío en modo demo)
GMAIL_USER=
GMAIL_PASS=
BREVO_USER=
BREVO_PASS=
MAILER_USER=
MAILER_PASS=

# Google APIs (dejar vacío en modo demo)
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
GOOGLE_MAP_KEY=
